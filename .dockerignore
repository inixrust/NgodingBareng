# Semua yang tidak boleh masuk ke build context.
# Menjaga context tetap kecil = build lebih cepat & tidak ada rahasia yang bocor.

.git
.gitignore
.github
.idea
.vscode
*.md
!src/README.md

# Berkas Docker itu sendiri tidak perlu ikut ke dalam image aplikasi
compose*.yaml
compose*.yml

# Rahasia — JANGAN pernah masuk image
.env
.env.*
!.env.example
src/.env
src/.env.*
!src/.env.example

# Dependency dibangun ulang di dalam stage vendor/assets
src/vendor
src/node_modules
src/public/build
src/public/hot
src/public/storage

# Artefak runtime
src/storage/app/*
!src/storage/app/.gitignore
src/storage/framework/cache/*
src/storage/framework/sessions/*
src/storage/framework/views/*
src/storage/logs/*
src/bootstrap/cache/*
!src/bootstrap/cache/.gitignore

# Test & tooling yang tidak dibutuhkan di produksi
src/tests
src/phpunit.xml
src/.phpunit.result.cache
src/.editorconfig
src/.gitattributes

# Berkas OS
.DS_Store
Thumbs.db
desktop.ini
