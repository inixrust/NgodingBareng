# =============================================================================
# Konfigurasi Docker Compose + Laravel.
#
# Salin menjadi .env lalu sesuaikan:
#     cp .env.example .env
#
# File ini dibaca oleh Compose (untuk ${...} di compose.yaml) sekaligus
# diteruskan sebagai environment variable ke dalam container aplikasi.
# JANGAN commit file .env yang sudah berisi nilai asli.
# =============================================================================

# --- Compose ----------------------------------------------------------------
APP_IMAGE=laravel-app
APP_TAG=latest
APP_PORT=8080
APP_TLS_PORT=8443
DB_PORT_HOST=3306
REDIS_PORT_HOST=6379
VITE_PORT=5173
XDEBUG_MODE=off

# Menentukan web server mana yang dipakai: "caddy" (default) atau "nginx".
# Keduanya fungsional setara; Caddy sekalian mengurus TLS otomatis.
COMPOSE_PROFILES=caddy

# --- Caddy ------------------------------------------------------------------
# Biarkan http://localhost:8080 untuk lokal. Untuk produksi isi domain sungguhan
# (mis. SITE_ADDRESS=app.contoh.com) — Caddy akan menerbitkan sertifikat
# Let's Encrypt sendiri. Untuk itu petakan port host 80->8080 dan 443->8443.
SITE_ADDRESS=http://localhost:8080
ACME_EMAIL=rustan@inixindobdg.co.id

# --- Aplikasi ---------------------------------------------------------------
APP_NAME=Laravel
APP_ENV=production
# Hasilkan dengan: docker compose run --rm artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

# --- Log --------------------------------------------------------------------
# "stderr" agar log tertangkap `docker compose logs`, bukan menumpuk di disk
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
# GANTI kedua nilai ini. Contoh generator:
#   docker run --rm alpine sh -c "head -c 24 /dev/urandom | base64"
DB_PASSWORD=ubah-password-ini
DB_ROOT_PASSWORD=ubah-root-password-ini

# --- Redis ------------------------------------------------------------------
# Dua instance terpisah, karena kebijakan eviction Redis berlaku per-server:
#   redis       -> queue + session, noeviction   (job TIDAK boleh dibuang)
#   redis-cache -> cache saja,      allkeys-lru  (entri lama memang boleh dibuang)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ubah-redis-password-ini
REDIS_DB=0
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=ubah-redis-cache-password-ini
REDIS_CACHE_DB=1

# --- Session / cache / queue ------------------------------------------------
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# WAJIB true begitu aplikasi dilayani lewat HTTPS. Biarkan false selama masih
# http://localhost, karena browser membuang cookie "secure" pada koneksi biasa.
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Horizon ----------------------------------------------------------------
# Dashboard di /horizon. Di luar APP_ENV=local, hanya email di daftar ini yang
# boleh membukanya (pisahkan dengan koma). Kosong = tidak ada yang bisa masuk.
HORIZON_ALLOWED_EMAILS=rustan@inixindobdg.co.id

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS=rustan@inixindobdg.co.id
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite -------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# --- Di balik reverse proxy / load balancer ---------------------------------
# Isi dengan IP/CIDR proxy, atau "*" bila proxy sudah dipercaya sepenuhnya.
# Tanpa ini Laravel salah membaca skema (http vs https) dan IP klien.
# TRUSTED_PROXIES=*
