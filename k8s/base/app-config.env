# Konfigurasi non-rahasia untuk semua workload PHP.
# Semua yang rahasia ada di Secret (lihat overlays/*/secrets.env), tidak di sini.
#
# File ini dibaca configMapGenerator, yang menambahkan hash isi ke nama
# ConfigMap. Akibatnya setiap perubahan di sini otomatis memicu rollout pod
# yang memakainya. ConfigMap biasa TIDAK begitu: nilainya berubah di cluster,
# tapi pod yang sudah jalan tetap memegang nilai lama sampai ada yang
# me-restart-nya secara manual.

APP_NAME=Laravel
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_URL=http://localhost

# stderr agar log masuk ke `kubectl logs`, bukan menumpuk di dalam container
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# rootfs bersifat read-only, sehingga home bawaan www-data tidak bisa ditulis.
# Tanpa ini `php artisan tinker` gagal dengan
# "Writing to directory /home/www-data/.config/psysh is not allowed".
# /tmp sudah dipasang sebagai emptyDir yang writable.
HOME=/tmp

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_HOST=redis-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=1

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
# Biarkan false selama akses masih http://localhost. Set true begitu ada TLS.
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis

MAIL_MAILER=log

# Traffic masuk lewat Service/Ingress di dalam cluster, sehingga header
# X-Forwarded-* selalu berasal dari jaringan privat.
TRUSTED_PROXIES=*

# Email yang boleh membuka /horizon di luar APP_ENV=local, dipisah koma.
# Kosong = tertutup untuk semua orang.
#
# CATATAN: gate ini memeriksa email milik user yang SEDANG LOGIN. Selama
# aplikasi belum punya mekanisme autentikasi, $user selalu null dan /horizon
# tetap menjawab 403 — daftar ini baru berpengaruh setelah ada cara login.
HORIZON_ALLOWED_EMAILS=rustan@inixindobdg.co.id

# Migrasi dijalankan Job terpisah (migrate-job.yaml), bukan oleh entrypoint tiap
# pod — kalau tidak, kedua replika app akan bermigrasi bersamaan saat rollout.
RUN_MIGRATIONS=false
WAIT_FOR_DB=true
