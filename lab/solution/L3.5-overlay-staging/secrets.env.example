# Salin menjadi secrets.env di direktori yang sama, lalu isi nilainya.
# JANGAN berbagi berkas ini dengan overlay lain — tiap lingkungan punya
# rahasianya sendiri.
#
# Hasilkan APP_KEY:  docker compose run --rm artisan key:generate --show
APP_KEY=
DB_PASSWORD=ganti-nilai-ini
DB_ROOT_PASSWORD=ganti-nilai-ini
REDIS_PASSWORD=ganti-nilai-ini
REDIS_CACHE_PASSWORD=ganti-nilai-ini
