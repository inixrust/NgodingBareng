# Build context dikirim SELURUHNYA ke daemon Docker sebelum satu instruksi
# pun dijalankan. Yang tidak dikecualikan di sini akan ikut terkirim --
# termasuk rahasia.

# --- rahasia (alasan keamanan, bukan sekadar kerapian) ---
.env
.env.*
!.env.example
*.pem
*.key
.env.local

# --- artefak yang dibangun ulang di dalam image ---
src/vendor
src/node_modules
src/public/build
src/public/hot
# ^ public/hot yang terbawa membuat produksi memuat aset dari
#   localhost:5173 milik pengembang. Seluruh tampilan situs rusak, dan
#   penyebabnya sangat sulit ditebak.
src/storage/framework/cache/*
src/storage/framework/sessions/*
src/storage/framework/views/*
src/storage/logs/*
src/bootstrap/cache/*

# --- tidak dibutuhkan saat runtime ---
.git
.github
.gitignore
docs
kubernetes
infra
scripts
compose.yaml
README.md
*.md
src/tests
src/phpunit.xml
src/.phpunit.cache
