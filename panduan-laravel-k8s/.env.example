# ============================================================================
# .env.example — TEMPLAT untuk Docker Compose (pengembangan lokal).
#
# Salin menjadi .env, lalu isi APP_KEY:
#     cp .env.example .env
#     docker compose run --rm app php artisan key:generate --show
#
# CATATAN PENTING TENTANG KUBERNETES
# Berkas ini TIDAK dipakai di Kubernetes sama sekali. Di sana, konfigurasi
# datang dari ConfigMap (nilai biasa) dan Secret (rahasia), disuntikkan
# sebagai variabel lingkungan. Container produksi bahkan tidak punya berkas
# .env — dan itu memang disengaja: satu berkas .env yang terbawa ke image
# berarti kredensial produksi ikut tersebar ke setiap Node.
# ============================================================================

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8080
APP_LOCALE=id

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Nama host = nama service di compose.yaml, sama seperti nama Service di
# Kubernetes. Kesamaan ini disengaja supaya kode tidak perlu tahu ia sedang
# berjalan di mana.
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=rahasia-lokal
DB_ROOT_PASSWORD=root-lokal

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_HOST=redis-cache

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"
